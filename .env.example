# Copia este archivo como .env (o deja que /configurar-elevenlabs lo cree). Nunca compartas .env.
ELEVENLABS_API_KEY=pega_aqui_tu_api_key

# Una voz por canal: ELEVENLABS_VOICE_ID_<CANAL> (nombre de la carpeta en mayúsculas, guiones → guiones bajos)
# Ejemplo para canales/mi-canal/:
# ELEVENLABS_VOICE_ID_MI_CANAL=pega_aqui_el_voice_id

# Modelo: eleven_multilingual_v2 (estable, buen español) o eleven_v3 (más expresivo)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Ajustes de voz (0.0–1.0). Se pueden cambiar por canal con sufijo: ELEVENLABS_STYLE_MI_CANAL=0.3
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0

# Zona horaria para programar publicaciones (horas respecto a UTC): -5 Colombia/Perú, -6 México, -3 Argentina, 1 España
ZONA_HORARIA_UTC=-5

# Solo si tu proyecto de Google Cloud pasó la auditoría de YouTube (ver docs/youtube-conexion.md)
YOUTUBE_PROYECTO_AUDITADO=false
